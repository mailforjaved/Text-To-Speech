<?xml version="1.0" encoding="UTF-8"?>
<widget
  id="com.local.texttospeech"
  version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:gap="http://phonegap.com/ns/1.0">

  <name>Text to Speech Reader</name>
  <description>A local text-to-speech reader that loads a dictionary file and speaks each line using device voices.</description>
  <author email="you@example.com">Local User</author>

  <!-- Entry point -->
  <content src="index.html"/>

  <!-- Allow all network access (needed for online TTS voices) -->
  <access origin="*"/>
  <allow-intent href="http://*/*"/>
  <allow-intent href="https://*/*"/>

  <!-- Android permissions -->
  <platform name="android">
    <preference name="android-minSdkVersion" value="21"/>
    <preference name="android-targetSdkVersion" value="34"/>
    <preference name="Orientation" value="portrait"/>
    <preference name="Fullscreen" value="false"/>
  </platform>

  <!-- Make the WebView behave like a modern browser -->
  <preference name="DisallowOverscroll" value="true"/>
  <preference name="BackupWebStorage" value="none"/>
  <preference name="SplashScreenDelay" value="0"/>
  <preference name="LoadUrlTimeoutValue" value="700000"/>
  <preference name="android-webContentsDebuggingEnabled" value="true"/>

  <!-- PhoneGap Build: use latest Cordova Android engine -->
  <engine name="android" spec="~13.0.0"/>

  <!-- Required Cordova plugins -->
  <gap:plugin name="cordova-plugin-dialogs" source="npm"/>
  <gap:plugin name="cordova-plugin-device" source="npm"/>

</widget>
